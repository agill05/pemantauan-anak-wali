+const VIEW_ACCESS = {
+    admin: null,
+    guru: { deny: ["admin-manage"] },
+    siswa: { allow: ["dashboard", "kebiasaan", "karakter", "akademik", "profil-siswa"] },
+    ortu: { allow: ["profil-siswa"] }
+};
+
+function canAccessView(role, viewId) {
+    if (!role || !viewId) return true;
+    const rule = VIEW_ACCESS[String(role).toLowerCase()];
+    if (rule === undefined) return false;
+    if (rule === null) return true;
+    if (rule.allow) return rule.allow.includes(viewId);
+    if (rule.deny) return !rule.deny.includes(viewId);
+    return true;
+}
+
 function switchView(viewId) {
+    const role = appState.user ? appState.user.role : null;
+    if (role && viewId !== "login" && !canAccessView(role, viewId)) {
+        viewId = role === "ortu" ? "profil-siswa" : "dashboard";
+    }
+
     if (pendingKebiasaanQueue && pendingKebiasaanQueue.size > 0) {
         flushKebiasaanQueue();
     }
