                            class="w-full bg-slate-50 border border-slate-200 p-2 rounded-xl text-xs font-semibold outline-none text-slate-700">
                            <option value="">Semua Status</option>
                            <option value="perhatian">⚠️ Perlu Perhatian</option>
                            <option value="tuntas">✅ Tuntas / Baik</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 pt-1">
                    <button onclick="exportRekapCSV()"
                        class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-1.5 shadow-sm transition">
                        <i class="fas fa-file-excel"></i> Export Excel (.csv)
                    </button>
                    <button onclick="printLaporanRekap()"
                        class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-1.5 shadow-sm transition">
                        <i class="fas fa-print"></i> Cetak PDF / Print
                    </button>
                </div>
            </div>
            <div id="laporan-rekap-container" class="space-y-2"></div>
        </div>

        <div id="view-siswa" class="view-section p-4 space-y-3">
            <div class="flex gap-2">
                <div class="relative flex-1">
                    <i class="fas fa-search absolute left-3.5 top-3 text-slate-400"></i>
                    <input type="text" id="search-siswa-input" oninput="renderSiswaView()"
                        placeholder="Cari nama / NISN siswa..."
                        class="w-full bg-surface border border-slate-200 rounded-xl pl-10 pr-3 py-2.5 text-xs outline-none focus:border-primary">
                </div>
                <button data-role-visible="admin,guru" onclick="openModalSiswa()"
                    class="bg-primary text-white px-3 py-2.5 rounded-xl text-xs font-bold flex items-center gap-1 shadow-sm">
                    <i class="fas fa-plus"></i> Tambah
                </button>
            </div>
            <div id="siswa-card-container" class="space-y-2.5"></div>
        </div>

        <div id="view-admin-manage" class="view-section p-4 space-y-4">
            <div class="flex bg-slate-200/70 p-1 rounded-xl gap-2">
                <button onclick="switchAdminTab('guru')" id="btn-admin-tab-guru"
                    class="admin-tab-btn flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-surface text-primary shadow-sm">Guru</button>
                <button onclick="switchAdminTab('siswa')" id="btn-admin-tab-siswa"
                    class="admin-tab-btn flex-1 py-2 text-xs font-bold rounded-lg transition-all text-slate-600">Siswa</button>
                <button onclick="switchAdminTab('kelas')" id="btn-admin-tab-kelas"
                    class="admin-tab-btn flex-1 py-2 text-xs font-bold rounded-lg transition-all text-slate-600">Kelas</button>
            </div>

            <div id="admin-tab-guru" class="admin-tab-content space-y-3">
                <div class="flex justify-between items-center gap-2">
                    <input type="text" id="search-guru-input" oninput="renderAdminGuru()" placeholder="Cari guru..."
                        class="flex-1 bg-surface border border-slate-200 rounded-xl px-3 py-2 text-xs outline-none">
                    <button onclick="openModalGuru()"
                        class="bg-primary text-white px-3 py-2 rounded-xl text-xs font-bold"><i
                            class="fas fa-plus mr-1"></i> Guru</button>
                </div>
                <div id="admin-guru-list" class="space-y-2"></div>
            </div>

            <div id="admin-tab-siswa" class="admin-tab-content space-y-3 hidden">
                <div class="flex justify-between items-center gap-2">
                    <input type="text" id="search-admin-siswa-input" oninput="renderAdminSiswa()"
                        placeholder="Cari siswa..."
                        class="flex-1 bg-surface border border-slate-200 rounded-xl px-3 py-2 text-xs outline-none">
                    <button onclick="openModalSiswa()"
                        class="bg-primary text-white px-3 py-2 rounded-xl text-xs font-bold"><i
                            class="fas fa-plus mr-1"></i> Siswa</button>
                </div>
                <div id="admin-siswa-list" class="space-y-2"></div>
            </div>

            <div id="admin-tab-kelas" class="admin-tab-content space-y-3 hidden">
                <div class="flex justify-between items-center">
                    <h3 class="text-xs font-bold text-slate-600 uppercase">Daftar Kelas</h3>
                    <button onclick="openModalKelas()"
                        class="bg-primary text-white px-3 py-2 rounded-xl text-xs font-bold"><i
                            class="fas fa-plus mr-1"></i> Kelas</button>
                </div>
                <div id="admin-kelas-list" class="space-y-2"></div>
            </div>
        </div>

    </main>

    <div id="printable-area" class="hidden"></div>

    <nav id="bottom-nav" class="bg-surface border-t border-slate-200 fixed bottom-0 w-full z-20 hidden no-print">
        <div id="bottom-nav-items" class="flex justify-around items-center h-16"></div>
    </nav>

    <div id="loading-overlay"
        class="fixed inset-0 z-[100] hidden flex-col items-center justify-center text-white no-print">
        <div class="w-12 h-12 border-4 border-white/25 border-t-primary rounded-full animate-spin mb-3"></div>
        <p id="loading-text" class="text-xs font-semibold tracking-wide">Memproses...</p>
    </div>

    <div id="modal-container" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 no-print">
        <div class="bg-surface w-full max-w-md rounded-3xl p-6 shadow-xl max-h-[90vh] overflow-y-auto"
            id="modal-content-box"></div>
    </div>

