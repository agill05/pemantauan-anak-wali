/* ==================================================================
   Aplikasi Pemantauan Anak Wali — SMP Negeri 1 Talaga Jaya
   style.css — Modern Flat & Glassmorphism Design System
   ================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

:root {
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --primary-light: #eff6ff;
    --secondary: #059669;
    --accent: #d97706;
    --danger: #dc2626;
    --background: #f8fafc;
    --surface: #ffffff;
    --border-subtle: #e2e8f0;
    --radius-lg: 1rem;
    --radius-xl: 1.25rem;
    --shadow-soft: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
    --shadow-hover: 0 10px 25px -5px rgba(15, 23, 42, 0.1);
}

* {
    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
}

body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0f172a;
    background-color: var(--background) !important;
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.01em;
}

button,
input,
select,
textarea {
    font-family: inherit;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

button:active {
    transform: scale(0.97);
}

/* Area Sentuh Minimal 44px (Mobile First UX) */
.touch-btn {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
}

/* Visibilitas Berbasis Role */
[data-role-visible]:not(.view-section) {
    display: none !important;
}

body[data-role="admin"] [data-role-visible*="admin"]:not(.view-section) {
    display: flex !important;
}

body[data-role="guru"] [data-role-visible*="guru"]:not(.view-section) {
    display: flex !important;
}

body[data-role="siswa"] [data-role-visible*="siswa"]:not(.view-section) {
    display: flex !important;
}

/* Login Screen UI */
#view-login {
    display: none !important;
    background: radial-gradient(100% 100% at 50% 0%, #eff6ff 0%, #f8fafc 100%);
}

#view-login.active {
    display: flex !important;
}

.login-card {
    backdrop-filter: blur(16px);
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: 0 20px 40px -15px rgba(37, 99, 235, 0.08);
}

.login-role-btn {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: #64748b;
}

.login-role-btn:hover {
    border-color: #cbd5e1;
    background: #ffffff;
}

.login-role-btn.selected {
    border-color: var(--primary) !important;
    background-color: var(--primary-light) !important;
    color: var(--primary) !important;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

/* Glassmorphism Header & Bottom Nav */
#main-header {
    background: rgba(37, 99, 235, 0.95) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: env(safe-area-inset-top);
}

#bottom-nav {
    background: rgba(255, 255, 255, 0.92) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 -4px 20px rgba(15, 23, 42, 0.05);
    border-top: 1px solid rgba(226, 232, 240, 0.8);
    padding-bottom: env(safe-area-inset-bottom);
}

.nav-item {
    transition: color 0.2s ease, transform 0.15s ease;
}

.nav-item.active {
    color: var(--primary) !important;
}

.nav-item.active i {
    background: var(--primary-light);
    border-radius: 0.75rem;
    padding: 0.35rem 0.65rem;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
}

/* Kartu & Elevasi Surface */
.bg-surface,
.bg-white {
    background-color: #ffffff;
    box-shadow: var(--shadow-soft);
}

@media (hover: hover) and (pointer: fine) {
    #main-content .bg-surface:hover,
    #main-content .bg-white:hover {
        box-shadow: var(--shadow-hover);
        transform: translateY(-1.5px);
    }
}

/* Modal Overlay & Pop Animation */
#modal-container {
    background: rgba(15, 23, 42, 0.45) !important;
    backdrop-filter: blur(6px);
}

#modal-container:not(.hidden) #modal-content-box {
    animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalPop {
    from {
        opacity: 0;
        transform: scale(0.94) translateY(12px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

/* Transisi Halaman/View Smooth */
.view-section {
    display: none;
}

.view-section.active {
    display: block;
    animation: slideUpFade 0.28s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideUpFade {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Skeleton Shimmer Loading */
.skeleton {
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 37%, #f1f5f9 63%);
    background-size: 400% 100%;
    animation: skeletonShimmer 1.4s ease infinite;
    border-radius: 0.75rem;
}

@keyframes skeletonShimmer {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
}

/* Empty State Styling */
.empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
    color: #94a3b8;
    background: #ffffff;
    border-radius: var(--radius-xl);
    border: 1.5px dashed #cbd5e1;
}

/* Scrollbar Minimalis */
::-webkit-scrollbar {
    width: 5px;
    height: 5px;
}
::-webkit-scrollbar-track {
    background: transparent;
}
::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 999px;
}
::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
}

.no-scrollbar::-webkit-scrollbar {
    display: none;
}
.no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
}

/* Accessiblity Focus Ring */
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
}

.view-section {
    padding-bottom: calc(6rem + env(safe-area-inset-bottom, 24px)) !important;
}

#bottom-nav {
    padding-bottom: env(safe-area-inset-bottom, 0px);
}
