                ? `<tr><td colspan="${heads.length}" style="text-align: center;">${e(emptyText)}</td></tr>`
                : rows.join("")}</tbody>
        </table>`;
    const c = v => `<td style="text-align: center;">${e(v)}</td>`;
    const l = v => `<td style="text-align: left;">${e(v)}</td>`;

    const biodata = [
        ["Nama Siswa", siswa.nama],
